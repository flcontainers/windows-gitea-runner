# Copy to .env and fill in. Changes apply on `docker compose up -d` (see README, "Changing settings later").
# Keep comments on their own lines: compose reads "KEY= # note" as the value "# note".

# --- VM (dockur/windows) ---
# dockur VERSION: 2025 or 2022 (evaluation media, converted to a full edition when KMS_HOST is set)
WIN_VERSION=2025
WIN_RAM=32G
WIN_CPUS=12
WIN_DISK=200G
WIN_USER=Docker
WIN_PASSWORD=change-me
# Where the web console (8006) and RDP (3389) are published
BIND_ADDR=127.0.0.1

# --- Gitea runner ---
GITEA_INSTANCE_URL=https://gitea.example.com
# Site/Org/Repo settings > Actions > Runners > Create new runner
GITEA_RUNNER_TOKEN=
RUNNER_NAME=win-runner-01
RUNNER_LABELS=windows-latest:host,windows-2025:host
# "5" = newest 5.x (recommended: majors have breaking changes), "latest", or exact "5.1.1"
RUNNER_VERSION=5
RUNNER_CAPACITY=1

# --- Automatic updates (gitea-runner to RUNNER_VERSION, VS2022 to latest 17.x) ---
# Comma-separated weekdays; empty disables the auto-update task
UPDATE_DAYS=Sunday
UPDATE_TIME=03:00
# Give up on this window if a job is still running after this many minutes
UPDATE_MAX_WAIT_MIN=240

# --- KMS activation ---
# Hostname/IP of your KMS server, "auto" for DNS (_vlmcs._tcp) discovery,
# or empty to stay on the evaluation licence.
KMS_HOST=
KMS_PORT=1688
# ServerStandard or ServerDatacenter; the evaluation install is converted to it
KMS_EDITION=ServerStandard
# Empty = Microsoft's public GVLK for the OS build and edition
KMS_CLIENT_KEY=

# --- Locale ---
# Keyboard as a culture name (fr-FR = AZERTY); applied to the logon screen and every user
LOCALE_KEYBOARD=fr-FR
# Windows time zone ID (tzutil /l lists them); Europe/Paris is "Romance Standard Time"
LOCALE_TIMEZONE=Romance Standard Time
